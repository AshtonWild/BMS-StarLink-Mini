(version 1)
(rule "Wire-solder pads: 1mm to other-net copper pours"
  (condition "A.Type == 'Pad' && (A.memberOfFootprint('BT*') || A.memberOfFootprint('P*')) && B.Type == 'Zone'")
  (constraint clearance (min 1.0mm)))

(rule "JLC 2oz: via to track 0.2mm"
  (condition "A.Type == 'Via' && B.Type == 'Track' && A.Net != B.Net")
  (constraint clearance (min 0.2mm)))
